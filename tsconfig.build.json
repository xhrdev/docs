// This file exists because the npm:prepare script is a multi-step pipeline:
// sdk/openapi.ts is generated by openapi-typescript, sdk/spec-generated.ts is
// generated by generate-openapi-string.js, and both are copied into dist/ before
// compilation. Because these files don't exist at normal tsconfig.json resolution
// time, they can't be included there. This project file targets only those
// generated dist/ files. TypeScript 6 also requires using `-p` rather than
// passing files directly on the CLI (TS5112), so this serves both purposes.
{
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "rootDir": "dist",
    "target": "ES2024",
    "module": "ESNext",
    "skipLibCheck": true
  },
  "files": [
    "dist/sdk.ts",
    "dist/spec-generated.ts",
    "dist/openapi.ts"
  ]
}
